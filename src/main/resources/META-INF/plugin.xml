<idea-plugin>
    <id>com.ebook.reader</id>
    <name>Output Viewer</name>
    <vendor email="support@example.com">Internal Tools</vendor>

    <description><![CDATA[
        A simple output viewer plugin for development tools.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Output"
            anchor="bottom"
            factoryClass="com.ebook.reader.EbookToolWindowFactory"
            icon="/icons/toolWindow.svg"
        />
    </extensions>

    <actions>
        <action
            id="com.ebook.reader.ToggleAction"
            class="com.ebook.reader.ToggleReaderAction"
            text="Toggle Output Viewer"
            description="Toggle output viewer visibility">
            <keyboard-shortcut keymap="$default" first-keystroke="meta P"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
