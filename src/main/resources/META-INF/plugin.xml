<idea-plugin>
    <id>com.ebook.reader</id>
    <name>BookWorm</name>
    <vendor email="support@example.com">shenyu</vendor>

    <description><![CDATA[
        A lightweight ebook reader embedded in your IDE. Read books without leaving your workspace.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="BookWorm"
            anchor="bottom"
            factoryClass="com.ebook.reader.EbookToolWindowFactory"
            icon="/icons/toolWindow.svg"
        />
    </extensions>

    <actions>
        <action
            id="com.ebook.reader.ToggleAction"
            class="com.ebook.reader.ToggleReaderAction"
            text="Toggle BookWorm"
            description="Toggle BookWorm reader visibility">
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
